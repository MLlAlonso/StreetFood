{
  "expo": {
    "name": "Buska",
    "slug": "streetfood",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "Buska",
    "userInterfaceStyle": "light",
    "icon": "./src/assets/logo/icon.png",
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-image",
      "@react-native-community/datetimepicker",
      "expo-splash-screen",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Buska necesita tu ubicación para encontrar negocios cercanos.",
          "locationAlwaysAndWhenInUsePermission": "Buska necesita acceso a tu ubicación en segundo plano para compartir la ubicación en vivo de tu negocio mientras esté activa.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "react-native-maps"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "usesCleartextTraffic": true,
      "package": "com.mllalonsosteam.Buska"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./src/assets/logo/icon.png"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "37ce63d0-1d7b-46d9-b79b-4c4240b1d66e"
      }
    },
    "owner": "mllalonsos-team"
  }
}