{
  "expo": {
    "name": "Buska",
    "slug": "streetfood",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "Buska",
    "userInterfaceStyle": "light",
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-image",
      "@react-native-community/datetimepicker",
      "expo-splash-screen",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.mllalonsosteam.Buska"
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "37ce63d0-1d7b-46d9-b79b-4c4240b1d66e"
      }
    },
    "owner": "mllalonsos-team"
  }
}
