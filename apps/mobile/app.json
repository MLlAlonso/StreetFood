{
  "expo": {
    "name": "StreetFood",
    "slug": "streetfood",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "streetfood",
    "userInterfaceStyle": "light",

    "experiments": {
      "typedRoutes": true
    },

    "plugins": [
      "expo-router",
      "expo-font",
      "expo-image"
    ],

    "ios": {
      "supportsTablet": true
    },

    "android": {
      "predictiveBackGestureEnabled": false
    },

    "web": {
      "bundler": "metro"
    }
  }
}